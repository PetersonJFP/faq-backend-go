// Variáveis de Ambiente
@baseUrl = http://localhost:8080/api/faqs
// COPIE O TOKEN DO LOGIN AQUI
@authToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjE3Nzg0MjIyOTUsInVzZXJfaWQiOjF9.BP9Ok37pX_1gAL7HbnWmMiqXkKQ4tbMGPhyf185rpyM

###
// 1. Listar todas as FAQs (Público)
GET {{baseUrl}}/
Accept: application/json

###
// 2. Criar uma nova FAQ (Protegido - Necessita Token)
POST {{baseUrl}}/
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "question": "Como funciona o JWT?",
    "answer": "O token é validado pelo middleware antes de chegar ao handler.",
    "is_premium": false
}

###
// 3. Atualizar uma FAQ (Protegido - Necessita Token)
// Substitua o {id} pelo ID real do banco
PUT {{baseUrl}}/19
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "question": "Pergunta Atualizada",
    "answer": "Resposta atualizada via rota protegida.",
    "is_premium": true
}

###
// 4. Deletar uma FAQ (Protegido - Necessita Token)
DELETE {{baseUrl}}/16
Authorization: Bearer {{authToken}}

###
// 5. Teste de Falha: Tentar criar sem Token (Deve retornar 401)
POST {{baseUrl}}/
Content-Type: application/json

{
    "question": "Isto vai falhar?",
    "answer": "Sim, falta o header de autorização.",
    "is_premium": false
}